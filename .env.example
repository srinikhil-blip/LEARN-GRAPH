# LearnGraph — Environment Configuration

# Application
APP_NAME=LearnGraph
FRONTEND_URL=http://localhost:5173
JWT_SECRET=learngraph_prod_jwt_super_secret_key_2026_sec#981

# Email Service Provider
# Options: resend | sendgrid | ses | mailgun | smtp
# Default auto-detect priority: Resend > SendGrid > AWS SES > Mailgun > SMTP
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=LearnGraph
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# 1. Resend (Recommended — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=LearnGraph <onboarding@resend.dev>

# 2. SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@learngraph.ai

# 3. AWS SES
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=

# 4. Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=noreply@learngraph.ai

# 5. SMTP (Gmail or standard SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
