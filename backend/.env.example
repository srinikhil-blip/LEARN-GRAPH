# =============================================================
# LearnGraph Backend — Environment Configuration
# =============================================================

# Application Settings
APP_NAME=LearnGraph
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-32-char-random-secret-key
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=*
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://learngraph.ai

# PostgreSQL with pgvector
DATABASE_URL=postgresql+asyncpg://learngraph:learngraph_password@localhost:5432/learngraph
POSTGRES_DB=learngraph
POSTGRES_USER=learngraph
POSTGRES_PASSWORD=learngraph_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Neo4j Graph Database (Knowledge Graph Engine)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j

# JWT & Cryptographic Security
JWT_SECRET_KEY=learngraph_prod_jwt_super_secret_key_2026_sec#981
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Providers (Tutor & Adaptive Generation)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_AI_MODEL=gpt-4o-mini

# Email Delivery (Verification, Password Resets)
# Options: resend | sendgrid | smtp | mailgun
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=LearnGraph
EMAIL_FROM=noreply@learngraph.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
RESEND_API_KEY=
SENDGRID_API_KEY=

# Frontend Base URL
FRONTEND_URL=http://localhost:5173
